# Lead Outreach CRM — self-hosted (your server)
#
# Copy to .env and fill in. Never commit .env or share it in chat.
# Provider credentials (Twilio / VoIP.ms) are NOT set here — the operator
# enters them in the web UI under Settings after deploy.

# REQUIRED — password for the web UI. Pick a strong one.
ADMIN_PASSWORD=

# Bind address and port. Keep 127.0.0.1: the Cloudflare tunnel is the
# front door; nothing needs to listen on the public interface.
HOST=127.0.0.1
PORT=8080

# SQLite file. Default is ./crm.db next to crm.py.
# CRM_DB=/opt/lead-crm/crm.db

# Public URL of the CRM, used to validate Twilio webhook signatures
# behind the tunnel. Set this once the DNS name exists.
PUBLIC_BASE_URL=https://crm.example.com

# Optional shared secret for the VoIP.ms webhook. If set, VoIP.ms
# callback requests must include ?secret=<this value>.
# VOIPMS_WEBHOOK_SECRET=
